{
  "name": "new-app",
  "version": "1.0.0",
  "description": "NEW - Personal Habit & Goal Tracker",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.new.app",
    "productName": "NEW",
    "icon": "icon.ico",
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "frontend/dist/frontend/browser",
        "to": "frontend/browser"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
